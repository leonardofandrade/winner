# Copiado para .env.dev na primeira execução de deploy/dev.sh.
# A senha em DATABASE_URL tem de ser a mesma de MYSQL_PASSWORD.
# O host db é o serviço MySQL desta compose, não o MySQL do Extractor.
SECRET_KEY=dev-only-troque-se-for-compartilhar-esse-ambiente
DEBUG=True
ALLOWED_HOSTS=*
DATABASE_URL=mysql://winner:winner@db:3306/winner
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_PASSWORD=winner
TELEGRAM_BOT_TOKEN=
